{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Presentation Manifest",
  "type": "object",
  "required": ["schema_version", "paper", "slides", "quality", "publication"],
  "properties": {
    "schema_version": {"const": 1},
    "paper": {
      "type": "object",
      "required": ["title_zh", "title_en", "short_title", "authors", "venue", "year"],
      "properties": {
        "title_zh": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "short_title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "venue": {"type": "string", "minLength": 1},
        "year": {"type": "string", "minLength": 1}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "latex_body", "narration", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {"type": "string"},
          "section": {"type": "string"},
          "title": {"type": "string"},
          "frame_options": {"type": "string"},
          "latex_body": {"type": "string", "minLength": 1},
          "narration": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim"],
              "properties": {
                "claim": {"type": "string", "minLength": 1},
                "paper_page": {"type": "integer", "minimum": 1},
                "figure": {"type": "string"},
                "equation": {"type": "string"},
                "table": {"type": "string"},
                "reference": {"type": "string"},
                "url": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "profile",
        "target_duration_minutes",
        "minimum_slides",
        "minimum_figure_slides",
        "minimum_equation_slides",
        "minimum_narration_characters"
      ],
      "properties": {
        "profile": {"const": "full-explainer"},
        "target_duration_minutes": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "minimum_slides": {"type": "integer", "minimum": 1},
        "minimum_figure_slides": {"type": "integer", "minimum": 0},
        "minimum_equation_slides": {"type": "integer", "minimum": 0},
        "minimum_narration_characters": {"type": "integer", "minimum": 1},
        "maximum_narration_characters": {"type": "integer", "minimum": 1}
      }
    },
    "publication": {
      "type": "object",
      "required": ["title", "tags", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "tid": {"type": "integer"},
        "description": {"type": "string", "minLength": 20},
        "copyright": {"type": "integer", "enum": [1, 2]},
        "source": {"type": "string"},
        "cover_path": {"const": "cover.png"}
      }
    }
  }
}
