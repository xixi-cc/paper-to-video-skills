% beamerthemesustech-elements.sty
% Theme author: 杨昊波 (Haobo Yang) — 2026 届计算机系博士 · github.com/yhbcode000 · yhbcode000@foxmail.com
% 可复用排版宏与环境（基于标准 beamer 构件，键入 SUSTech 学术配色）。
% 由 beamerthemesustech.sty 在加载 color 主题之后引入，故可直接使用
% sustechred / sustechred2 / sustechblue / sustechink 等颜色。
\ProvidesPackage{beamerthemesustech-elements}[2026/08/05 SUSTech themed elements (Madrid-based)]

\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{amsmath}

% --- 文字配色别名（强调=红 / 关键词=红 / 表头=主蓝）---------------------------
\colorlet{emph}{sustechred}
\colorlet{kw}{sustechred}
\colorlet{hdr}{sustechblue}

% --- 强调 / 高亮 -------------------------------------------------------------
\newcommand{\shl}[1]{\textbf{\textcolor{emph}{#1}}}        % 强调（红、粗）
\newcommand{\keyword}[1]{\textbf{\textcolor{kw}{#1}}}      % 关键词（红、粗）
\newcommand{\brandemph}[1]{\textit{\textcolor{emph}{#1}}}  % 品牌强调（红、斜）
\newcommand{\hlbox}[1]{\colorbox{sustechred2!22}{#1}}       % 浅红底高亮（重要数字）

% --- 图与图注 ----------------------------------------------------------------
% \fitfigure{file}：限宽限高、保持比例，避免溢出
\newcommand{\fitfigure}[1]{\includegraphics[width=\linewidth,height=0.86\textheight,keepaspectratio]{#1}}
% 图注前缀（默认“图”，可用 \setfigureprefix 改为 Figure 等）
\newcommand{\figureprefix}{图}
\newcommand{\setfigureprefix}[1]{\renewcommand{\figureprefix}{#1}}
% \figcap{n}{文字} -> "图 n: 文字" — 自动换行并居中，标题始终在图下方
\newcommand{\figcap}[2]{\par\smallskip{\centering\footnotesize\color{sustechgrey}\mbox{\figureprefix~#1:}~#2\par}}

% --- 论文分享语义页 ----------------------------------------------------------
% 这些宏只生成 frame 内部内容，便于 manifest 渲染器统一包裹 frame。
% \paperfigure{file}{figure-label}{evidence-caption}{takeaway}
\newcommand{\paperfigure}[4]{%
  \centering
  \includegraphics[width=\linewidth,height=0.62\textheight,keepaspectratio]{#1}\par
  \figcap{#2}{#3}
  \vspace{0.35em}
  \begin{minipage}{0.94\linewidth}
    \begin{callout}[结论]\small #4\end{callout}
  \end{minipage}
}

% \equationderivation{assumptions}{aligned-rows}{interpretation}{takeaway}
% 第二个参数只写 aligned 内部的行，例如 A&=B\\&=C。
\newcommand{\equationderivation}[4]{%
  \begin{block}{条件与适用范围}\small #1\end{block}
  \vspace{-0.25em}
  \begin{equation*}
    \begin{aligned}#2\end{aligned}
  \end{equation*}
  \vspace{-0.35em}
  \begin{block}{推导解释}\small #3\end{block}
  \vspace{-0.25em}
  \begin{callout}[本页关键]\small #4\end{callout}
}

% \baselinecomparison{condition}{metric}{baseline}{paper}{delta}{takeaway}
\newcommand{\baselinecomparison}[6]{%
  \begin{block}{比较条件}\small #1\end{block}
  \vspace{-0.2em}
  \centering
  \begin{tabular}{@{}p{0.27\linewidth}p{0.28\linewidth}p{0.28\linewidth}@{}}
    \toprule
    \theadrow\thc{指标} & \thc{基线} & \thc{本文方法} \\
    \midrule
    #2 & #3 & \textbf{#4} \\
    \bottomrule
  \end{tabular}\par
  \vspace{0.45em}
  {\small\textbf{差值 / 增益：}\hlbox{#5}\par}
  \vspace{0.35em}
  \begin{callout}[结论]\small #6\end{callout}
}

% --- 指标大数字 --------------------------------------------------------------
% \metric{100\%}{成功率}
\newcommand{\metric}[2]{%
  \begin{minipage}[t]{0.30\textwidth}\centering
    {\fontsize{22}{24}\selectfont\textbf{\textcolor{emph}{#1}}}\\[0.2em]
    {\small\color{sustechgrey}#2}
  \end{minipage}}

% --- 要点框 callout（红色 alertblock）----------------------------------------
\newenvironment{callout}[1][要点]{\begin{alertblock}{#1}}{\end{alertblock}}

% --- 表格辅助 ----------------------------------------------------------------
\newcommand{\theadrow}{\rowcolor{hdr}}     % 表头底色行（主蓝）
\newcommand{\altrow}{\rowcolor{cardgrey}}  % 隔行浅灰
\newcommand{\thc}[1]{{\color{white}\bfseries #1}}

% --- 间距节律 ----------------------------------------------------------------
\newcommand{\tightgap}{\vspace{0.18em}}
\newcommand{\deckgap}{\vspace{0.45em}}

% --- 分区宽度 ----------------------------------------------------------------
\newcommand{\zonetext}{0.55\textwidth}
\newcommand{\zonefig}{0.42\textwidth}
\newcommand{\zonehalf}{0.48\textwidth}

% --- 章节分隔页（Part 编号 + 标题 + 一句话主旨）------------------------------
% 在每个 \section 之前用 \renewcommand{\secblurb}{...} 设置本节主旨。
\newcommand{\secblurb}{}
\AtBeginSection[]{%
  \begin{frame}[plain,c]
    \centering
    {\color{sustechgrey}\large Part~\thesection}\\[0.6em]
    {\color{sustechblue}\Huge\bfseries\insertsectionhead}\\[0.8em]
    {\color{emph}\rule{2cm}{2pt}}\\[1.0em]
    \begin{minipage}{0.78\textwidth}\centering
      {\color{sustechink}\normalsize\secblurb}
    \end{minipage}
  \end{frame}}

\mode<all>
